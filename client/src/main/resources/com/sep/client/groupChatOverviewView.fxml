<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="428.0" prefWidth="828.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sep.client.controller.groupChatOverviewController">
   <children>
      <TableView fx:id="groupTable" layoutX="9.0" layoutY="91.0" prefHeight="272.0" prefWidth="807.0">
        <columns>
          <TableColumn fx:id="groupnameCol" prefWidth="362.0" text="Gruppe" />
          <TableColumn fx:id="participantCol" prefWidth="83.0" text="Teilnehmer" />
            <TableColumn fx:id="descriptionCol" prefWidth="365.0" text="Beschreibung" />
        </columns>
      </TableView>
      <Label layoutX="374.0" layoutY="14.0" text="Gruppen">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="JoinButton" layoutX="747.0" layoutY="382.0" mnemonicParsing="false" onAction="#onJoinButtonEvent" text="Beitreten" />
      <Button fx:id="BackButton" layoutX="9.0" layoutY="382.0" mnemonicParsing="false" onAction="#onBackButtonEvent" text="Zurück" />
      <Button fx:id="CreateGroupButton" layoutX="362.0" layoutY="382.0" mnemonicParsing="false" onAction="#onCreateGroupButton" text="Gruppe erstellen" />
      <TextField fx:id="searchField" layoutX="240.0" layoutY="51.0" onKeyTyped="#onSearchFieldKeyEntered" prefHeight="25.0" prefWidth="340.0" />
   </children>
</AnchorPane>
