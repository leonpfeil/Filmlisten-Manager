<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sep.client.controller.ProfileController">
   <children>
      <ImageView fx:id="profilePicImageView" fitHeight="100.0" fitWidth="100.0" layoutX="25.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" />
      <Label layoutX="25.0" layoutY="23.0" text="Profilbild">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="changeProfileButton" layoutX="23.0" layoutY="156.0" mnemonicParsing="false" onAction="#onUploadPfpButtonEvent" text="Profilbild ändern" />
      <Button fx:id="securitySettingsButton" layoutX="495.0" layoutY="70.0" mnemonicParsing="false" onAction="#onSecuritySettingsButtonEvent" text="Sicherheit" />
      <Label layoutX="482.0" layoutY="24.0" text="Einstellungen">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="usernameLabel" layoutX="125.0" layoutY="28.0" text="username" />
      <Button fx:id="confirmButton" layoutX="23.0" layoutY="188.0" mnemonicParsing="false" onAction="#onConfirm" prefHeight="25.0" prefWidth="104.0" text="Bestätigen" />
      <Button fx:id="userStatisticButton" layoutX="25.0" layoutY="335.0" mnemonicParsing="false" onAction="#onUserStatisticButton" prefHeight="42.0" prefWidth="104.0" text="Eigene Statistik aufrufen" wrapText="true" />
   </children>
</AnchorPane>
