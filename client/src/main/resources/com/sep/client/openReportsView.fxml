<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="634.0" prefWidth="831.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sep.client.controller.OpenReportsController">
    <children>
        <Button fx:id="closeMainpageButton" layoutX="593.0" layoutY="559.0" mnemonicParsing="false" onAction="#onCloseButtonEvent" prefHeight="41.0" prefWidth="148.0" text="Seite schließen!">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <TableView fx:id="table" layoutX="50.0" layoutY="67.0" prefHeight="479.0" prefWidth="722.0">
            <columns>
                <TableColumn fx:id="reportIDCol" prefWidth="42.0" text="ID" />
                <TableColumn fx:id="movieNameCol" prefWidth="184.0" text="Filmname" />
                <TableColumn fx:id="reportMessageCol" prefWidth="395.0" text="Report Message" />
                <TableColumn fx:id="userCol" prefWidth="100.0" text="User" />
            </columns>
        </TableView>
        <Label layoutX="61.0" layoutY="28.0" prefHeight="41.0" prefWidth="83.0" text="Reports">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
        <Button fx:id="reportErledigt" layoutX="204.0" layoutY="554.0" mnemonicParsing="false" onAction="#onReportErledigtButton" prefHeight="25.0" prefWidth="125.0" text="Report erledigt" />
        <Button fx:id="change" layoutX="61.0" layoutY="554.0" mnemonicParsing="false" onAction="#onChangeButton" prefHeight="25.0" prefWidth="125.0" text="Bearbeiten" />
    </children>
</AnchorPane>
